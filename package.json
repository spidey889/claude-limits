{
  "name": "claude-limits",
  "version": "0.1.0",
  "private": true,
  "description": "Windows CLI tools for Claude and Codex usage limits: fresh Claude readings and offline Codex snapshots.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests.ps1",
    "test:claude": "node --test test/*.test.cjs",
    "test:codex": "powershell -NoProfile -ExecutionPolicy Bypass -File ./codex/tests.ps1"
  },
  "license": "MIT"
}
